// OVERTRIP Database Schema
// SQLite + Prisma ORM (MVP)
// Source of truth for administrative data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Rascunhos privados; aprovação apenas registra revisão, não publica.
model SocialPost {
  id         String              @id @default(cuid())
  // Nullable during the staged migration; legacy (pre-organization) rows
  // remain unassigned and stay reachable only through the legacy routes.
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title      String
  version    Int                 @default(1)
  approvedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  variants   SocialPostVariant[]

  @@index([organizationId])
}

model SocialPostVariant {
  id       String     @id @default(cuid())
  postId   String
  platform String
  caption  String
  socialMediaId String?
  socialMedia SocialMedia? @relation(fields: [socialMediaId], references: [id], onDelete: Restrict)
  post     SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
}

// Arquivos imutáveis e privados, fora da pasta de imagens públicas.
model SocialMedia {
  id          String @id @default(cuid())
  // Nullable during the staged migration; legacy (pre-organization) rows
  // remain unassigned and stay reachable only through the legacy routes.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storageKey  String @unique
  sha256      String
  mimeType    String
  width       Int
  height      Int
  sizeBytes   Int
  createdById String
  createdAt   DateTime @default(now())
  variants    SocialPostVariant[]

  @@index([organizationId])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRIP: Viagens e experiências comerciais da OVERTRIP
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model Trip {
  id        String   @id @default(cuid())
  // Nullable during the staged migration; legacy records remain untouched.
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  
  // Identificação
  title             String
  headlineDisplay   String?
  category          String
  filterCategory    String?  // Categoria escolhida para o filtro do site
  description       String
  city              String
  region            String
  
  // Datas (ISO 8601 com timezone)
  startDateISO      DateTime
  endDateISO        DateTime?
  
  // Horários
  departureTime     String?
  departureTolerance String?
  returnTime        String?
  scheduleInfo      String?
  scheduleTBD       Boolean   @default(false)
  
  // Preços
  priceValue        Float?  // Decimal stored as Float for SQLite
  priceDisplay      String?
  priceUnit         String    @default("por pessoa")
  free              Boolean   @default(false)
  
  // Características
  intensityClass    String
  spotsLeft         Int?
  trailDistance     String?
  supportPoint      String?
  supportPointInfo  String?
  
  // Embarque (ponto único - legacy)
  meetingCity       String?
  meetingPoint      String?
  meetingTBD        Boolean   @default(false)
  meetingDetails    String?
  meetingMapsQuery  String?
  
  // Conteúdo (JSON stored as String)
  includes          String      // JSON string: ["Banho de rio", ...]
  includesHighlight String?
  includedServices  String?     // JSON string
  itinerary         String?     // JSON string
  routeNotes        String?     // JSON string
  importantInfo     String?     // JSON string
  media             String      // JSON string: [{src, alt, focus, type}, ...]
  
  // CTA
  buttonLabel       String    @default("Quero viajar")
  buttonClass       String    @default("button-dark")
  
  // Status e SEO
  status            String    @default("DRAFT") // DRAFT, REVIEW, OPEN, COMPLETED, CANCELLED, SOLD_OUT, CLOSED
  availabilitySchema String    @default("https://schema.org/InStock")
  
  // Rastreabilidade de importação
  storedIdentity    String    @unique  // "trips_json:0", "trips_json:1", etc.
  
  // Busca normalizada (case/accent-insensitive)
  titleSearch       String    @default("")
  citySearch        String    @default("")
  categorySearch    String    @default("")
  
  // Metadados
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  publishedAt       DateTime?
  
  // Relações
  departures        TripDeparture[]
  documents         TripDocument[]
  visits            Visit[]
  galleryEntries    GalleryEntry[]
  reservations      Reservation[]
  leads             Lead[]
  
  @@index([status])
  @@index([startDateISO])
  @@index([storedIdentity])
  @@index([titleSearch])
  @@index([citySearch])
  @@index([categorySearch])
  @@index([organizationId])
}

// Reservas são registros internos; não alteram vagas nem processam pagamentos.
model Reservation {
  id            String   @id @default(cuid())
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customerName  String
  customerPhone String?
  seats         Int      @default(1)
  status        String   @default("PENDING")
  totalCents    Int
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  installments  ReservationInstallment[]

  @@index([tripId, status])
  @@index([leadId])
  @@index([organizationId])
}

model ReservationInstallment {
  id            String   @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amountCents   Int
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reservationId])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RESERVATION_AUDIT_LOG: trilha mínima de quem mudou o quê numa reserva
// - Só ator, ação, entidade, empresa e quando. Nunca senha, nome/telefone de
//   cliente, valor em centavos, observação ou conteúdo de documento.
// - organizationId/actorUserId/reservationId/entityId são referências
//   simples (sem relação Prisma), o mesmo padrão já usado em createdById de
//   MediaAsset/TripDocument — propositalmente para não alterar nenhum outro
//   modelo (Organization, User, Reservation) só para acrescentar auditoria.
// - Só as rotas de organização (organizationReservationRoutes.ts) escrevem
//   aqui, sempre na mesma transação da mutação. O painel legado
//   (reservationRoutes.ts, reservas sem empresa) não grava nada aqui.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model ReservationAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String
  // RESERVATION_CREATED | RESERVATION_UPDATED | INSTALLMENT_CREATED |
  // INSTALLMENT_UPDATED | INSTALLMENT_DELETED
  action         String
  // "Reservation" | "ReservationInstallment"
  entityType     String
  entityId       String
  // Reserva "dona", mesmo quando entityType é uma parcela — permite listar
  // o histórico completo de uma reserva com uma única consulta.
  reservationId  String
  createdAt      DateTime @default(now())

  @@index([organizationId, reservationId, createdAt])
  @@index([organizationId, createdAt])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRIP_DOCUMENT: Arquivos privados anexados à preparação de uma viagem
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// O arquivo físico nunca fica no banco, em assets/ ou em URL pública. storageKey
// é uma chave opaca gerada pelo servidor para o diretório privado configurado.
model TripDocument {
  id               String   @id @default(cuid())
  tripId           String
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  originalFilename String
  storageKey       String   @unique
  mimeType         String
  sizeBytes        Int
  sha256           String
  createdById      String

  // PENDING_SCAN, CLEAN, INFECTED, ERROR, DELETED
  scanStatus       String   @default("PENDING_SCAN")
  // PENDING, PROCESSING, READY, FAILED, SKIPPED
  extractionStatus String   @default("PENDING")
  extractionStartedAt DateTime?
  extractedAt       DateTime?
  extractionError   String?
  pages             TripDocumentPage[]

  // Retenção vale para o arquivo físico e para os metadados. Após excluir o
  // arquivo, deletedAt preserva uma trilha mínima de auditoria até a limpeza.
  retentionUntil DateTime
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tripId])
  @@index([scanStatus])
  @@index([extractionStatus, scanStatus])
  @@index([retentionUntil])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MEDIA_ASSET: Imagens enviadas pelo painel (só metadados)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Os arquivos ficam em UPLOADS_DIR (fora do repositório e do site publicado),
// reprocessados e sem EXIF. storageKey é gerado pelo servidor; o nome do
// arquivo enviado não é guardado. path é o src público da versão principal.
model MediaAsset {
  id            String   @id @default(cuid())
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storageKey    String   @unique
  path          String   @unique
  mimeType      String
  width         Int
  height        Int
  sizeBytes     Int      // versão principal reprocessada
  originalBytes Int      // arquivo recebido
  sha256        String   // do arquivo recebido; evita duplicar o mesmo envio
  createdById   String
  createdAt     DateTime @default(now())
  // null = registro pendente: criado antes de gravar os arquivos, ainda não
  // confirmado. A rota pública nunca serve um registro pendente (fecha a
  // janela em que o arquivo existe em disco sem publicação confirmada).
  publishedAt   DateTime?
  // JSON (string) com [{name, sizeBytes, sha256}] de cada arquivo esperado
  // (principal + variantes), gravado ANTES de escrever qualquer arquivo. A
  // mera existência de um arquivo não prova que a gravação terminou antes de
  // uma queda (pode estar truncado); reconcilePendingMedia só publica um
  // pendente se o conteúdo real de cada arquivo bater exatamente com isto.
  // Nulo em registro antigo (anterior a este campo): tratado como "não
  // verificável", nunca publicado automaticamente.
  fileIntegrity String?

  @@index([sha256])
  @@index([organizationId])
}

// Texto privado, separado por página para preservar a origem das futuras sugestões.
model TripDocumentPage {
  id         String       @id @default(cuid())
  documentId String
  document   TripDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  text       String

  @@unique([documentId, pageNumber])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRIP_DEPARTURE: Múltiplos pontos de embarque
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model TripDeparture {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  time       String
  place      String
  city       String
  mapsUrl    String?
  mapsQuery  String?
  orderIndex Int
  
  createdAt  DateTime @default(now())
  
  @@index([tripId])
  @@index([orderIndex])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VISIT: Registro histórico de uma visita a um lugar específico
// - tripId OPCIONAL: visita pode não ter viagem associada
// - date OPCIONAL: visitas antigas podem não ter data precisa
// - lat/lng OPCIONAIS: coordenadas não inventadas
// - Múltiplas visitas ao mesmo lugar são ESPERADAS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model Visit {
  id          String    @id @default(cuid())

  // Nullable durante a migração escalonada; registros legados permanecem intocados.
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Relação OPCIONAL com Trip
  tripId      String?   // NULLABLE - visita pode não ter trip
  trip        Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  
  // Dados da visita
  title       String
  description String?
  date        DateTime? // NULLABLE - visitas antigas podem não ter data
  
  // Localização
  city        String
  region      String
  lat         Float?    // NULLABLE - sem coordenadas fictícias
  lng         Float?    // NULLABLE - sem coordenadas fictícias
  
  // Mídia (JSON string)
  images      String?   // JSON string: [{src, alt}, ...]
  
  // Rastreabilidade de importação
  storedIdentity String  @unique  // "visited_places_hardcoded:5", "gallery_hardcoded:2"
  source      String?   // "visited_places_hardcoded" | "gallery_hardcoded" | "manual"
  needsReview Boolean   @default(true)
  notes       String?
  
  // Busca normalizada (case/accent-insensitive)
  titleSearch   String    @default("")
  citySearch    String    @default("")
  regionSearch  String    @default("")
  sourceSearch  String    @default("")
  
  // Relações
  galleryEntries GalleryEntry[]
  
  // Metadados
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([tripId])
  @@index([organizationId])
  @@index([lat, lng])
  @@index([date])
  @@index([needsReview])
  @@index([storedIdentity])
  @@index([titleSearch])
  @@index([citySearch])
  @@index([regionSearch])
  @@index([sourceSearch])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GALLERY_ENTRY: Memória editorial curada para a galeria do site
// - NÃO é automática de Trip ou Visit
// - Curadoria manual: título, descrição, seleção de fotos, ordenação
// - Associações OPCIONAIS a Trip e/ou Visit
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model GalleryEntry {
  id        String   @id @default(cuid())

  // Nullable durante a migração escalonada; registros legados permanecem intocados.
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Conteúdo editorial (OBRIGATÓRIO)
  title     String
  date      DateTime  // Para ordenação
  dateDisplay String  // "28 de maio de 2023" (legível)
  description String
  images    String    // JSON string: [{src, alt}, ...] - mínimo 1
  
  // Associações OPCIONAIS (para rastreabilidade)
  tripId    String?   // Trip que gerou esta memória
  trip      Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  visitId   String?   // Visit específica (se aplicável)
  visit     Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  
  // Curadoria
  isFeatured Boolean  @default(false)  // Primeiro card (destaque)
  orderIndex Int      // Ordem manual se necessário
  
  // Rastreabilidade
  storedIdentity String  @unique  // "gallery_hardcoded:0"
  source    String?   // "gallery_hardcoded" | "manual"
  
  // Busca normalizada (case/accent-insensitive)
  titleSearch       String    @default("")
  descriptionSearch String    @default("")
  
  // Metadados
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([date])
  @@index([isFeatured])
  @@index([tripId])
  @@index([visitId])
  @@index([organizationId])
  @@index([storedIdentity])
  @@index([titleSearch])
  @@index([descriptionSearch])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// USER: Autenticação administrativa (single user MVP)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String
  credentialVersion Int @default(0)
  role      String   @default("admin")
  legacyAccess Boolean @default(false) // acesso explícito ao painel global de turismo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedKnowledge AssistantKnowledgeVersion[]
  memberships Membership[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PASSWORD RESET: token de uso único para "esqueci minha senha".
// Guarda só o hash (sha256) do token enviado por e-mail, nunca o valor
// bruto. Expiração curta (ver config.passwordResetTokenTtlMinutes) e
// usedAt marca consumo; a troca de senha e o consumo do token são
// atômicos (ver passwordResetService). Vale para qualquer User, de
// qualquer organização ou do painel legado — não é escopado por empresa.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // Campo legado da primeira migração de reset; não valida credenciais.
  issuedForUpdatedAt DateTime
  // Versão da senha, independente da versão de sessão alterada no logout.
  issuedCredentialVersion Int @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ORGANIZATION / MEMBERSHIP: fundação para múltiplas agências (primeira etapa)
// Modelos isolados: nenhuma rota legada (trips, leads, reservas, site público)
// lê ou depende destes modelos ainda. Só a nova rota /api/organizations os usa.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  // Preenche a unidade de preço ao abrir "Nova viagem" nesta empresa; não
  // é usado pelo site público (Trip guarda o próprio priceUnit, igual ao
  // legado) e nunca se aplica a outra empresa ou ao acervo legado.
  defaultPriceUnit String?
  // Cor própria do painel da empresa (#RRGGBB, validada e revalidada no
  // servidor em organizationController.ts). null = sem identidade
  // configurada, usa a paleta verde fixa (ver src/validators/
  // organizationBrand.ts); nunca derivada do id.
  brandColor  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships Membership[]
  trips       Trip[]
  leads       Lead[]
  reservations Reservation[]
  visits      Visit[]
  galleryEntries GalleryEntry[]
  mediaAssets    MediaAsset[]
  socialPosts    SocialPost[]
  socialMedia    SocialMedia[]

  @@index([status])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER, ADMIN, MEMBER
  status         String       @default("ACTIVE") // ACTIVE, REVOKED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

// Cada registro é uma versão aprovada completa; o serviço não altera versões.
model AssistantKnowledgeVersion {
  version      Int      @id @default(autoincrement())
  entries      String   // JSON validado pelo serviço
  approvedById String
  approvedBy   User     @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime @default(now())
  responseAudits AssistantResponseAudit[]
}

// Metadados mínimos, sem texto de conversa ou identificadores de clientes.
model AssistantResponseAudit {
  id               String   @id @default(cuid())
  knowledgeVersion Int?
  knowledge        AssistantKnowledgeVersion? @relation(fields: [knowledgeVersion], references: [version], onDelete: Restrict)
  outcome          String
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([knowledgeVersion])
}

model AssistantConversationState {
  id        String   @id
  state     String   @default("ASSISTANT")
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
  events    AssistantConversationEvent[]
  notices   AssistantHandoffNotice[]
}

model AssistantHandoffNotice {
  id             String   @id @default(cuid())
  conversationId String
  requestEventId String
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  leaseToken     String?
  leaseUntil     DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   AssistantConversationState @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, requestEventId])
  @@index([status, createdAt])
}

model AssistantConversationEvent {
  conversationId String
  eventId        String
  event          String
  expectedRevision Int
  resultState    String
  resultRevision Int
  createdAt      DateTime @default(now())
  conversation   AssistantConversationState @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, eventId])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SETTINGS: Configurações globais
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// IMPORT_SNAPSHOT: Backup imutável dos dados originais
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
model ImportSnapshot {
  id            String   @id @default(cuid())
  label         String   // "import-2026-10-29T10:00:00.000Z"
  tripsJson     String   // JSON string
  visitedPlaces String   // JSON string
  gallery       String   // JSON string
  createdAt     DateTime @default(now())
  
  @@index([createdAt])
}

// CRM interno: informações de interessados não são expostas no catálogo público.
model Lead {
  id             String      @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  phone          String?
  email          String?
  stage          String      @default("NEW")
  tripId         String?
  trip           Trip?       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  responsible    String?
  nextFollowUpAt DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  events         LeadEvent[]
  reservations   Reservation[]

  @@index([stage])
  @@index([tripId])
  @@index([nextFollowUpAt])
  @@index([organizationId])
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}
