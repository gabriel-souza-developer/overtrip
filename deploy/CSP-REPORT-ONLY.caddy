# Adicione esta diretiva ao bloco HTTPS do domínio no Caddyfile ativo.
# Não substitua o Caddyfile da Oracle pelo arquivo histórico deste repositório.
header Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://unpkg.com; script-src-attr 'none'; style-src 'self' https://fonts.googleapis.com https://unpkg.com; style-src-attr 'none'; img-src 'self' data: blob: https://unpkg.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org; font-src 'self' data: https://fonts.gstatic.com https://unpkg.com; connect-src 'self' https://photon.komoot.io https://servicodados.ibge.gov.br; report-uri /api/csp-report"
