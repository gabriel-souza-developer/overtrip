# Copie para /etc/overtrip/env (fora do repositório) e preencha. chmod 600.
NODE_ENV=production
PORT=3001
JWT_SECRET=
DATABASE_URL=
CORS_ORIGIN=
# Recuperação de senha: preencher no servidor com chave transacional restrita
# e remetente verificado; nunca incluir credenciais no repositório.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=OVERTRIP
PASSWORD_RESET_URL_BASE=https://overtrip.com.br/admin
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
GEMINI_API_KEY=
AI_MODEL=
# PDFs privados: configurar após preparar armazenamento, scanner e backups.
DOCUMENT_STORAGE_DIR=/var/lib/overtrip/documents
DOCUMENT_CLAMDSCAN_PATH=/usr/bin/clamdscan
DOCUMENT_PDFTOTEXT_PATH=/usr/bin/pdftotext

# Habilite apenas após preparar o ambiente e verificar o provedor configurado.
DOCUMENT_AI_EXTERNAL_ENABLED=false

# Imagens enviadas pelo painel (fora do repositório e de /srv/overtrip-public).
# Padrão em produção: /var/lib/overtrip/uploads (já coberto por ReadWritePaths).
UPLOADS_DIR=/var/lib/overtrip/uploads
