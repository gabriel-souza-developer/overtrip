# Copie para /etc/overtrip/env (fora do repositório) e preencha. chmod 600.
NODE_ENV=production
PORT=3001
JWT_SECRET=
DATABASE_URL=
CORS_ORIGIN=
GEMINI_API_KEY=
AI_MODEL=
# PDFs privados: configurar após preparar armazenamento, scanner e backups.
DOCUMENT_STORAGE_DIR=/var/lib/overtrip/documents
DOCUMENT_CLAMDSCAN_PATH=/usr/bin/clamdscan
DOCUMENT_PDFTOTEXT_PATH=/usr/bin/pdftotext

# Habilite apenas após preparar o ambiente e verificar o provedor configurado.
DOCUMENT_AI_EXTERNAL_ENABLED=false
