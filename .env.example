# Database Connection String
# For local SQLite/PostgreSQL environment
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth
JWT_SECRET="overtrip-secret-key-change-in-production-2026"

# Environment
NODE_ENV="development"
PORT="3001"

# Plataforma multinicho: usar banco e segredo diferentes dos do turismo.
# PLATFORM_DATABASE_URL="file:./platform.db"
# PLATFORM_JWT_SECRET="defina-um-segredo-aleatorio-independente"
# PLATFORM_PORT=3002
# Para desenvolver /espaco, iniciar o Vite com VITE_PLATFORM_MODE=true
# e PLATFORM_API_TARGET=http://127.0.0.1:3002.

# "Esqueci minha senha" (opcional): integração gratuita com a API transacional
# da Brevo para enviar o e-mail com o link de redefinição. Sem BREVO_API_KEY
# e BREVO_SENDER_EMAIL, o serviço fica indisponível e a rota responde isso
# com clareza, sem fingir que enviou o e-mail.
BREVO_API_KEY=
# Precisa ser um remetente validado na conta Brevo em uso.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=OVERTRIP
# URL fixa (nunca lida do Host/Origin da requisição) usada para montar o link
# de redefinição enviado por e-mail: só a origem + caminho, SEM query string
# nem fragmento (o link final já acrescenta seu próprio caminho e
# fragmento). Em produção, com BREVO_API_KEY/BREVO_SENDER_EMAIL configurados
# (recuperação de senha ativada), é OBRIGATÓRIA, precisa usar HTTPS, a
# origem (esquema+host) precisa ser igual a CORS_ORIGIN (senão a checagem de
# Origin das rotas de autenticação rejeitaria a própria página do link), e o
# caminho precisa ser exatamente /admin (ex.: https://overtrip.com.br/admin
# — o painel é publicado em /admin, ver vite.config.ts "base"). Fora de
# produção, se configurada, o caminho precisa ser a raiz (painel servido lá
# em dev); sem a variável, cai no próprio CORS_ORIGIN.
PASSWORD_RESET_URL_BASE=
# Validade do token de redefinição, em minutos.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Ajuda de IA no painel (opcional). Sem nenhuma chave, o bloco "Preencher com IA" não aparece.
# Sem AI_PROVIDER_ORDER (uso simples, um só provedor): se GEMINI_API_KEY (ou GOOGLE_API_KEY) existir, usa Gemini (plano gratuito); senão ANTHROPIC_API_KEY.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo usado pela IA nesse modo simples. Deve combinar com o provedor em uso (gemini-* com chave Gemini, claude-* com chave Anthropic). Vazio = padrão do provedor (Gemini: gemini-3.5-flash-lite; Anthropic: claude-opus-5-5).
AI_MODEL=

# Groq (groq.com, tem camada gratuita) e xAI/Grok (x.ai). Cada um só é usado se tiver a própria chave.
GROQ_API_KEY=
GROQ_MODEL=
XAI_API_KEY=
XAI_MODEL=
# Ative o encadeamento com reserva: lista (separada por vírgula) a ordem de tentativa entre groq, xai, gemini, anthropic.
# Só os que tiverem chave configurada entram na fila; se a principal falhar (erro, limite, chave inválida), tenta a próxima.
# Sem esta variável, vale só o comportamento simples acima (Gemini > Anthropic, sem reserva).
AI_PROVIDER_ORDER=

# PDFs privados: preencher somente após configurar ClamAV e retenção/backup.
# Diretório absoluto fora do repositório e de qualquer webroot.
DOCUMENT_STORAGE_DIR=
# Executável clamdscan absoluto; daemon ClamAV deve conseguir ler os arquivos.
DOCUMENT_CLAMDSCAN_PATH=

# Extrator do worker independente (Poppler); configure caminho absoluto.
DOCUMENT_PDFTOTEXT_PATH=/usr/bin/pdftotext

# Envia texto de PDF ao provedor de IA somente quando um administrador solicitar.
DOCUMENT_AI_EXTERNAL_ENABLED=false

# Serviço separado, local e somente leitura; defina 32 bytes aleatórios em hex.
ASSISTANT_SERVICE_SECRET=
ASSISTANT_SERVICE_PORT=3010

# Entrada de solicitações de reserva do n8n (processo separado, loopback).
# Credencial PRÓPRIA de escrita: 32 bytes em hex, diferente da de leitura acima.
# Em produção fica em /etc/overtrip/reservation-intake.env, não no env da API.
RESERVATION_INTAKE_SECRET=
RESERVATION_INTAKE_PORT=3011
# Dias de retenção dos metadados de idempotência (7 a 730; padrão 90).
RESERVATION_INTAKE_RETENTION_DAYS=90

# Site público e assistente OVERTRIP (/api/public/trips, catálogo do agente):
# por padrão só mostram viagens sem organização (organizationId null, dado
# legado). Para liberar viagens de uma organização específica (ex.: backfill
# controlado de uma agência autorizada), liste os IDs exatos aqui, separados
# por vírgula. NUNCA use "*" ou "all": isolamento acidental de outra agência
# no site da OVERTRIP é uma falha de privacidade. Vazio = só dado legado.
PUBLIC_SITE_ORGANIZATION_IDS=

# Escopo da OPERAÇÃO legada (/api/trips, /api/leads, /api/reservations,
# documentos por tripId, dashboard, associações de visitas/galeria) —
# independente da variável acima, que só autoriza o que aparece no
# site/assistente público. Por padrão o painel legado só lista e edita
# viagens, interessados e reservas sem organização (organizationId null).
# Depois de aplicar scripts/backfill-tourism-organization.ts atribuindo os
# dados da OVERTRIP a uma organização, informe aqui o ID exato dessa ÚNICA
# organização (não é uma lista) para o painel continuar operando os mesmos
# dados. NUNCA "*" ou "all"; listagem/detalhe de visitas e galeria em si,
# o destaque global da galeria e a unicidade global de storedIdentity ainda
# não são isolados por empresa (ver pendências no relatório de revisão).
LEGACY_TOURISM_ORGANIZATION_ID=

# Required to enable the passenger registry; generate with: openssl rand -base64 32
PASSENGER_DATA_ENCRYPTION_KEY=
