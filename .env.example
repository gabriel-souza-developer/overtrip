# Database Connection String
# For local SQLite/PostgreSQL environment
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth
JWT_SECRET="overtrip-secret-key-change-in-production-2026"

# Environment
NODE_ENV="development"
PORT="3001"

# Ajuda de IA no painel (opcional). Sem a chave, o bloco "Preencher com IA" não aparece.
ANTHROPIC_API_KEY=
# Modelo usado pela IA. Vazio = padrão do código (claude-opus-5-5).
AI_MODEL=
