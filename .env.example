# Database Connection String
# For local SQLite/PostgreSQL environment
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth
JWT_SECRET="overtrip-secret-key-change-in-production-2026"

# Environment
NODE_ENV="development"
PORT="3001"

# Ajuda de IA no painel (opcional). Sem a chave, o bloco "Preencher com IA" não aparece.
# Provedor: se GEMINI_API_KEY (ou GOOGLE_API_KEY) existir, usa Gemini (plano gratuito); senão ANTHROPIC_API_KEY.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo usado pela IA. Deve combinar com o provedor em uso (gemini-* com chave Gemini, claude-* com chave Anthropic). Vazio = padrão do provedor (Gemini: gemini-3.5-flash-lite; Anthropic: claude-opus-5-5).
AI_MODEL=

# PDFs privados: preencher somente após configurar ClamAV e retenção/backup.
# Diretório absoluto fora do repositório e de qualquer webroot.
DOCUMENT_STORAGE_DIR=
# Executável clamdscan absoluto; daemon ClamAV deve conseguir ler os arquivos.
DOCUMENT_CLAMDSCAN_PATH=

# Extrator do worker independente (Poppler); configure caminho absoluto.
DOCUMENT_PDFTOTEXT_PATH=/usr/bin/pdftotext

# Envia texto de PDF ao provedor de IA somente quando um administrador solicitar.
DOCUMENT_AI_EXTERNAL_ENABLED=false
