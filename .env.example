# Database Connection String
# For local SQLite/PostgreSQL environment
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth
JWT_SECRET="overtrip-secret-key-change-in-production-2026"

# Environment
NODE_ENV="development"
PORT="3001"

# Ajuda de IA no painel (opcional). Sem a chave, o bloco "Preencher com IA" não aparece.
# Provedor: se GEMINI_API_KEY (ou GOOGLE_API_KEY) existir, usa Gemini (plano gratuito); senão ANTHROPIC_API_KEY.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo usado pela IA. Deve combinar com o provedor em uso (gemini-* com chave Gemini, claude-* com chave Anthropic). Vazio = padrão do provedor (Gemini: gemini-3.5-flash-lite; Anthropic: claude-opus-5-5).
AI_MODEL=
