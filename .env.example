# Database Connection String
# For local SQLite/PostgreSQL environment
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth
JWT_SECRET="overtrip-secret-key-change-in-production-2026"

# Environment
NODE_ENV="development"
PORT="3001"

# Ajuda de IA no painel (opcional). Sem a chave, o bloco "Preencher com IA" não aparece.
# Provedor: se GEMINI_API_KEY (ou GOOGLE_API_KEY) existir, usa Gemini (plano gratuito); senão ANTHROPIC_API_KEY.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo usado pela IA. Deve combinar com o provedor em uso (gemini-* com chave Gemini, claude-* com chave Anthropic). Vazio = padrão do provedor (Gemini: gemini-3.5-flash-lite; Anthropic: claude-opus-5-5).
AI_MODEL=

# PDFs privados: preencher somente após configurar ClamAV e retenção/backup.
# Diretório absoluto fora do repositório e de qualquer webroot.
DOCUMENT_STORAGE_DIR=
# Executável clamdscan absoluto; daemon ClamAV deve conseguir ler os arquivos.
DOCUMENT_CLAMDSCAN_PATH=

# Extrator do worker independente (Poppler); configure caminho absoluto.
DOCUMENT_PDFTOTEXT_PATH=/usr/bin/pdftotext

# Envia texto de PDF ao provedor de IA somente quando um administrador solicitar.
DOCUMENT_AI_EXTERNAL_ENABLED=false

# Serviço separado, local e somente leitura; defina 32 bytes aleatórios em hex.
ASSISTANT_SERVICE_SECRET=
ASSISTANT_SERVICE_PORT=3010

# Site público e assistente OVERTRIP (/api/public/trips, catálogo do agente):
# por padrão só mostram viagens sem organização (organizationId null, dado
# legado). Para liberar viagens de uma organização específica (ex.: backfill
# controlado de uma agência autorizada), liste os IDs exatos aqui, separados
# por vírgula. NUNCA use "*" ou "all": isolamento acidental de outra agência
# no site da OVERTRIP é uma falha de privacidade. Vazio = só dado legado.
PUBLIC_SITE_ORGANIZATION_IDS=

# Escopo da OPERAÇÃO legada (/api/trips, /api/leads, /api/reservations,
# documentos por tripId, dashboard, associações de visitas/galeria) —
# independente da variável acima, que só autoriza o que aparece no
# site/assistente público. Por padrão o painel legado só lista e edita
# viagens, interessados e reservas sem organização (organizationId null).
# Depois de aplicar scripts/backfill-tourism-organization.ts atribuindo os
# dados da OVERTRIP a uma organização, informe aqui o ID exato dessa ÚNICA
# organização (não é uma lista) para o painel continuar operando os mesmos
# dados. NUNCA "*" ou "all"; listagem/detalhe de visitas e galeria em si,
# o destaque global da galeria e a unicidade global de storedIdentity ainda
# não são isolados por empresa (ver pendências no relatório de revisão).
LEGACY_TOURISM_ORGANIZATION_ID=
